# URL pública del sitio (se usa para sitemap, robots y metadatos).
# En producción: https://tu-dominio.ec
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo para dudas y ejercicio de derechos de datos personales (se muestra en /privacidad y /terminos).
# Por defecto ya usa este correo.
NEXT_PUBLIC_CONTACT_EMAIL=thundertech73@gmail.com

# Versión de prueba (beta): 1 = no se indexa, robots.txt bloquea todo y se muestra el aviso «Versión de prueba».
# Quitar o poner 0 al lanzar. Se incrusta al compilar: hay que volver a desplegar.
NEXT_PUBLIC_BETA=0

# Este proyecto no necesita secretos. No guardes credenciales aquí.
